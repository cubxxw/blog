{
  "name": "cubxxw-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Blog E2E tests with Playwright",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:stop": "bash scripts/stop-netlify-dev.sh",
    "blockquotes:check": "node scripts/clean-empty-blockquotes.mjs",
    "blockquotes:fix": "node scripts/clean-empty-blockquotes.mjs --write",
    "frontmatter:check": "node scripts/check-frontmatter-fields.mjs",
    "articles:audit": "node scripts/audit-article-inventory.mjs",
    "briefs:list": "node scripts/brief-queue.mjs",
    "briefs:next": "node scripts/brief-queue.mjs --next",
    "briefs:check": "node scripts/brief-queue.mjs --check",
    "briefs:trace": "node scripts/brief-queue.mjs --trace",
    "briefs:dispatch": "node scripts/dispatch-blog-executor.mjs",
    "briefs:test": "node --test scripts/brief-queue.test.mjs scripts/dispatch-blog-executor.test.mjs",
    "tags:check": "node scripts/normalize-tags.mjs --check",
    "tags:fix": "node scripts/normalize-tags.mjs --write",
    "redirects:check": "node scripts/check-redirects.mjs",
    "redirects:fix": "node scripts/check-redirects.mjs --write",
    "seo:output:check": "node scripts/check-generated-seo.mjs",
    "products:check": "node scripts/check-product-integration.mjs",
    "flavor:check": "node scripts/check-ai-flavor.mjs --changed --check",
    "flavor:scan": "node scripts/check-ai-flavor.mjs",
    "geo:audit": "node scripts/geo-audit.mjs",
    "covers": "node --env-file-if-exists=.env scripts/generate-covers.mjs",
    "covers:write": "node --env-file-if-exists=.env scripts/generate-covers.mjs --write",
    "covers:test": "node --test scripts/generate-covers.test.mjs",
    "newsletter:test": "node --test scripts/buttondown-tags.test.mjs scripts/newsletter-state.test.mjs",
    "mcp:server": "node scripts/mcp-server.mjs",
    "baidu:push": "node scripts/baidu-push.mjs",
    "baidu:push:all": "node scripts/baidu-push.mjs --all",
    "baidu:push:dry": "node scripts/baidu-push.mjs --dry-run",
    "indexnow:push": "node scripts/indexnow-push.mjs",
    "indexnow:push:all": "node scripts/indexnow-push.mjs --all",
    "indexnow:push:dry": "node scripts/indexnow-push.mjs --dry-run",
    "seo:gsc": "node scripts/gsc-fetch.mjs",
    "seo:gsc:dry": "node scripts/gsc-fetch.mjs --dry-run",
    "seo:psi": "node scripts/psi-fetch.mjs",
    "seo:psi:dry": "node scripts/psi-fetch.mjs --dry-run",
    "seo:crux": "node scripts/crux-fetch.mjs",
    "seo:crux:dry": "node scripts/crux-fetch.mjs --dry-run",
    "typecheck": "tsc --noEmit && tsc --ignoreConfig --noEmit --strict --esModuleInterop --skipLibCheck --module Node16 --moduleResolution Node16 --target ES2020 --types node,@playwright/test playwright.interactive.config.ts",
    "interactive:check": "node scripts/check-interactive-specs.mjs && node --test tests/interactive/*.test.mjs && node scripts/build-interactive-fixtures.mjs",
    "interactive:test": "playwright test --config=playwright.interactive.config.ts",
    "interactive:serve": "node scripts/serve-interactive-fixtures.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "quality:source": "node scripts/check-content-quality.mjs source",
    "quality:output": "node scripts/check-content-quality.mjs output",
    "quality:test": "node --test scripts/ci-changes.test.mjs scripts/ci-workflows.test.mjs scripts/content-source.test.mjs scripts/content-quality-report.test.mjs scripts/content-output.test.mjs scripts/site-build.test.mjs scripts/site-artifact.test.mjs scripts/site-verify.test.mjs scripts/site-release.test.mjs scripts/newsletter-state.test.mjs scripts/release-followups.test.mjs scripts/backup-site.test.mjs scripts/generate-content-index.test.mjs scripts/audit-public-site.test.mjs scripts/search-delivery.test.mjs scripts/live-site-probes.test.mjs scripts/tag-workflow.test.mjs scripts/netlify-build-control.test.mjs",
    "site:build": "node scripts/site-build.mjs",
    "site:verify": "node scripts/site-verify.mjs"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "markdown-it": "15.0.2",
    "markdownlint": "0.41.1",
    "mermaid": "^12.0.0",
    "netlify-cli": "27.10.1",
    "netlify-plugin-critical-css": "1.0.4",
    "parse5": "8.0.1",
    "smol-toml": "1.9.0",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  }
}
