{
  "schemaVersion": 1,
  "kind": "agent-loop",
  "id": "safety-strings-loop-v1",
  "defaultScenario": "hostile-trace",
  "model": { "maxSteps": 4 },
  "scenarios": [
    {
      "id": "hostile-trace",
      "outcome": "success",
      "events": [
        {
          "kind": "decision",
          "copy": {
            "zh": { "text": "决策文本含 </script>、\"引号\"、<标签> 与换行：\n第二行。" },
            "en": { "text": "Decision text with </script>, \"quotes\", <tags> and a newline:\nsecond line." }
          }
        },
        {
          "kind": "tool_call",
          "tool": "run_command",
          "args": "{\"cmd\":\"echo </script> \\\"quoted\\\"\"}",
          "copy": {
            "zh": { "text": "请求里的命令只是文本 </script>。" },
            "en": { "text": "The command in the request is inert text </script>." }
          }
        },
        {
          "kind": "tool_result",
          "tool": "run_command",
          "status": "ok",
          "copy": {
            "zh": { "text": "</script><script>alert(4)</script>\n输出只是文本。" },
            "en": { "text": "</script><script>alert(4)</script>\nThe output is text only." }
          }
        },
        {
          "kind": "stop",
          "reason": "answered",
          "copy": {
            "zh": { "text": "停止原因 </script> \"quoted\" & <done>。" },
            "en": { "text": "Stop reason </script> \"quoted\" & <done>." }
          }
        }
      ]
    }
  ],
  "copy": {
